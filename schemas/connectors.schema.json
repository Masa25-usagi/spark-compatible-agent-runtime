{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-runtime.local/schemas/connectors.schema.json",
  "title": "Runtime connector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "connectors"],
  "properties": {
    "version": { "const": 1 },
    "connectors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "root"],
            "properties": {
              "kind": { "const": "local-files" },
              "root": { "type": "string", "minLength": 1 },
              "maxReadBytes": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "command", "allowedTools", "toolMap"],
            "properties": {
              "kind": { "const": "mcp-stdio" },
              "name": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string", "minLength": 1 },
              "envKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "allowedTools": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "toolMap": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tool", "operations"],
                  "properties": {
                    "tool": { "type": "string", "minLength": 1 },
                    "operations": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string" }
                    }
                  }
                }
              },
              "timeoutMs": { "type": "integer", "minimum": 1 },
              "maxMessageBytes": { "type": "integer", "minimum": 1 }
            }
          }
        ]
      }
    }
  }
}
